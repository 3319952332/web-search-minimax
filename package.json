{
  "name": "dsh-web-search-minimax",
  "version": "1.1.0",
  "description": "DSH web search provider over the MiniMax coding-plan direct search API (POST /v1/coding_plan/search), with a client card for the Plugins settings section",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
